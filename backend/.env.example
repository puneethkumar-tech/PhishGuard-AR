# PhishGuard-AR Environment Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-24-chars
JWT_SECRET_KEY=replace-with-another-long-random-secret-at-least-24-chars
DATABASE_URL=sqlite:///phishguard.db

# Frontend CORS allowlist (comma-separated URLs, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Token Lifespan (seconds)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# ML Model Configuration (Optional in development, provided by ML teammate)
MODEL_PATH=
MODEL_VERSION=not-loaded
